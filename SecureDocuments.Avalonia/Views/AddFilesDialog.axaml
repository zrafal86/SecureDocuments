<rxui:ReactiveUserControl
    x:Class="SecureDocuments.Avalonia.Views.AddFilesDialog"
    x:TypeArguments="vm:AddFilesDialogViewModel"
    xmlns:rxui="http://reactiveui.net"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:SecureDocuments.ViewModels;assembly=SecureDocuments"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    MinWidth="500">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Upload files"
            HorizontalAlignment="Center"
            FontSize="16"
            Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0" Grid.Column="0"
                VerticalAlignment="Center" Margin="0,0,8,0"
                Text="Audience: " />
            <ComboBox
                Grid.Row="0" Grid.Column="1"
                Margin="0,4"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                x:Name="RoleComboBox" />

            <TextBlock
                Grid.Row="1" Grid.Column="0"
                VerticalAlignment="Center" Margin="0,0,8,0"
                Text="Category: " />
            <ComboBox
                Grid.Row="1" Grid.Column="1"
                Margin="0,4"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                x:Name="FileCategoryComboBox" />

            <TextBlock
                Grid.Row="2" Grid.Column="0"
                VerticalAlignment="Center" Margin="0,0,8,0"
                Text="Tags: " />
            <TextBox
                x:Name="TagsTextBox"
                Grid.Row="2" Grid.Column="1"
                Watermark="Tags (separate by comma ',')"
                VerticalAlignment="Center"
                Margin="0,4" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ChooseFilesButton"
                Grid.Column="1"
                Content="Select files"
                Classes="Outlined" />
        </Grid>

        <ListBox
            Grid.Row="4"
            MaxHeight="300"
            x:Name="FilesListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding .}" Foreground="Gray" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Row="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Margin="8">
            <Button
                Command="{Binding $parent[dialogHost:DialogHost].CloseDialogCommand}"
                CommandParameter="{x:False}"
                Content="CANCEL"
                Classes="Flat"
                Margin="8,0" />
            <Button
                Command="{Binding $parent[dialogHost:DialogHost].CloseDialogCommand}"
                CommandParameter="{x:True}"
                Content="OK"
                Classes="Raised"
                Margin="8,0" />
        </StackPanel>
    </Grid>
</rxui:ReactiveUserControl>
