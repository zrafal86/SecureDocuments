<rxui:ReactiveWindow
    x:Class="SecureDocuments.Avalonia.Views.MainWindow"
    x:TypeArguments="vm:MainViewModel"
    xmlns:rxui="http://reactiveui.net"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:SecureDocuments.ViewModels;assembly=SecureDocuments"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:local="clr-namespace:SecureDocuments.Avalonia.Services"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    Title="Secure Documents"
    FontSize="16"
    Width="1280"
    Height="800">
    <dialogHost:DialogHost Identifier="MainDialogHost">
        <dialogHost:DialogHost.DialogContent>
            <ContentControl Content="{Binding $parent[dialogHost:DialogHost].DialogContent}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="local:MessageViewModel">
                        <StackPanel Margin="16" MinWidth="300">
                            <TextBlock
                                Text="{Binding Title}"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Margin="0,0,0,8" />
                            <TextBlock
                                Text="{Binding Message}"
                                HorizontalAlignment="Center"
                                MaxWidth="500"
                                TextAlignment="Left"
                                TextWrapping="Wrap"
                                Margin="15" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="8">
                                <Button
                                    Command="{Binding $parent[dialogHost:DialogHost].CloseDialogCommand}"
                                    CommandParameter="{x:False}"
                                    Margin="10,0,10,0"
                                    IsVisible="{Binding ShowCancel}"
                                    Content="No"
                                    Classes="Outlined" />
                                <Button
                                    Command="{Binding $parent[dialogHost:DialogHost].CloseDialogCommand}"
                                    CommandParameter="{x:True}"
                                    Margin="10,0,10,0"
                                    Content="OK"
                                    Classes="Raised" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="local:WaitViewModel">
                        <Border CornerRadius="14" Padding="16" Background="{DynamicResource MaterialDesignCardBackground}">
                            <ProgressBar
                                Width="80"
                                Height="80"
                                Classes="circular"
                                IsIndeterminate="True" />
                        </Border>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </dialogHost:DialogHost.DialogContent>
        <DockPanel LastChildFill="True">
            <DockPanel
                LastChildFill="True"
                DockPanel.Dock="Top"
                x:Name="LogoutPanel">
                <Button
                    x:Name="BackButton"
                    HorizontalAlignment="Left"
                    Classes="Icon"
                    ToolTip.Tip="Back">
                    <icons:MaterialIcon Kind="ArrowBack" Width="24" Height="24" />
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="ProfilButton"
                        Classes="Flat">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="Account" Width="20" Height="20" Margin="0,0,5,0" />
                            <TextBlock VerticalAlignment="Center">
                                <Run x:Name="UserNameRun" Text="User" />
                                <Run x:Name="RoleRun" Text="[Role]" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LogoutButton"
                        HorizontalAlignment="Right"
                        Classes="Icon"
                        ToolTip.Tip="Logout">
                        <icons:MaterialIcon Kind="LogoutVariant" Width="24" Height="24" />
                    </Button>
                </StackPanel>
            </DockPanel>

            <rxui:RoutedViewHost x:Name="RoutedViewHost" />

        </DockPanel>
    </dialogHost:DialogHost>
</rxui:ReactiveWindow>
