<rxui:ReactiveUserControl
    x:Class="SecureDocuments.Avalonia.Views.OffersView"
    x:TypeArguments="vm:OffersViewModel"
    xmlns:rxui="http://reactiveui.net"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:SecureDocuments.ViewModels;assembly=SecureDocuments"
    xmlns:models="clr-namespace:SecureDocuments.Models;assembly=SecureDocuments"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- Left panel: Offers list -->
        <Border
            Grid.Column="0"
            Padding="5"
            Margin="15"
            CornerRadius="15"
            Classes="Card"
            BoxShadow="0 4 14 2 #33000000">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <Button
                        x:Name="AddOfferButton"
                        DockPanel.Dock="Right"
                        Classes="Raised"
                        Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="Add" Width="20" Height="20" Margin="0,0,5,0" />
                            <TextBlock Text="Add offer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ExportOffersButton"
                        DockPanel.Dock="Right"
                        Classes="Outlined"
                        Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="Export" Width="20" Height="20" Margin="0,0,5,0" />
                            <TextBlock Text="Export" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RefreshOffersButton"
                        DockPanel.Dock="Left"
                        Classes="Icon">
                        <icons:MaterialIcon Kind="Refresh" Width="20" Height="20" />
                    </Button>
                    <TextBlock
                        Text="Offers"
                        FontSize="18"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </DockPanel>

                <!-- Search and filter -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <icons:MaterialIcon Kind="Search" Width="20" Height="20" VerticalAlignment="Center" Margin="5,0" />
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" Watermark="Search" />
                    </Grid>
                    <ComboBox
                        x:Name="StatusComboBox"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Stretch" />
                </Grid>

                <!-- Offers DataGrid -->
                <DataGrid
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    x:Name="OffersDataGrid"
                    SelectionMode="Single"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="True"
                    CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Manager" Binding="{Binding Manager.FullName}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedTime, StringFormat='yyyy/MM/dd'}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right panel: Offer details -->
        <Border
            Grid.Column="2"
            x:Name="DetailsPanel"
            Padding="5"
            Margin="15"
            CornerRadius="15"
            Classes="Card"
            BoxShadow="0 4 14 2 #33000000">
            <ScrollViewer>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Details toolbar -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="CloseDetailsPanelButton" Classes="Icon" Margin="0,0,4,0">
                                <icons:MaterialIcon Kind="Close" Width="20" Height="20" />
                            </Button>
                            <Button x:Name="AddOfferFileButton" Classes="Outlined" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:MaterialIcon Kind="Files" Width="20" Height="20" Margin="0,0,5,0" />
                                    <TextBlock Text="Files" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddInvoicesFileButton" Classes="Outlined" Margin="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:MaterialIcon Kind="CurrencyUsd" Width="20" Height="20" Margin="0,0,5,0" />
                                    <TextBlock Text="Invoices" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Text="Offer detail"
                            FontSize="16"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="AcceptButton" Classes="Raised" Margin="4,0" Width="80">Accept</Button>
                            <Button x:Name="RejectButton" Classes="Raised" Margin="4,0" Width="80">Reject</Button>
                            <Button x:Name="FinishButton" Classes="Raised" Margin="4,0" Width="80">Finish</Button>
                            <Button x:Name="ArchiveButton" Classes="Raised" Margin="4,0" Width="80">Archive</Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Details form -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4" x:Name="OfferNumber"
                            Watermark="Offer number" />

                        <TextBlock
                            Grid.Row="0" Grid.Column="2"
                            Margin="4" Text="Company name:"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="0" Grid.Column="3"
                            Margin="4" x:Name="CompanyNameComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBox
                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4" x:Name="OfferName"
                            Watermark="Project Name" />

                        <TextBox
                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4" x:Name="CustomerName"
                            Watermark="Customer name" />

                        <TextBox
                            Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4" x:Name="CustomerAddress"
                            Watermark="Customer Address" />

                        <TextBlock
                            Grid.Row="4" Grid.Column="0"
                            Margin="4" Text="Country:"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="4" Grid.Column="1"
                            Margin="4" x:Name="CustomerCountryComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Grid.Row="5" Grid.Column="0"
                            Margin="4" Text="Ship's flag:"
                            VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="5" Grid.Column="1"
                            Margin="4" x:Name="UnitFlagComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Grid.Row="1" Grid.Column="2"
                            Margin="4" Text="Type:"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="1" Grid.Column="3"
                            Margin="4" x:Name="TypeComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Grid.Row="2" Grid.Column="2"
                            Margin="4" Text="Subject:"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="2" Grid.Column="3"
                            Margin="4" x:Name="SubjectComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            x:Name="ApplicantLabel"
                            Grid.Row="3" Grid.Column="2"
                            Margin="4" Text="Applicant:"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="3" Grid.Column="3"
                            Margin="4" x:Name="ApplicantComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Grid.Row="4" Grid.Column="2"
                            Margin="4" Text="Manager:"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="4" Grid.Column="3"
                            Margin="4" x:Name="ManagerComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Grid.Row="5" Grid.Column="2"
                            Margin="4" Text="Builder:"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="5" Grid.Column="3"
                            Margin="4" x:Name="BuilderComboBox"
                            HorizontalAlignment="Stretch" />

                        <TextBlock
                            Grid.Row="6" Grid.Column="2"
                            Margin="4" Text="Technologist:"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ComboBox
                            Grid.Row="6" Grid.Column="3"
                            Margin="4" x:Name="TechnologistComboBox"
                            HorizontalAlignment="Stretch" />

                        <DatePicker
                            Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4" x:Name="StartDatePicker" />

                        <DatePicker
                            Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="4" x:Name="EstimatedEndDatePicker" />

                        <DatePicker
                            Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2"
                            Margin="4" x:Name="EndDatePicker" />

                        <Grid
                            x:Name="InitialGrossAmountParent"
                            Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2"
                            Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                x:Name="InitialGrossAmount"
                                Watermark="Estimated amount" />
                            <ComboBox
                                Grid.Column="1"
                                x:Name="CurrencyComboBox"
                                Margin="8,0,0,0"
                                Width="80"
                                VerticalAlignment="Center" />
                        </Grid>

                        <icons:MaterialIcon
                            Grid.Row="9" Grid.Column="0"
                            Kind="Pencil" Width="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3"
                            Margin="4" x:Name="OfferDescription"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="60"
                            Watermark="Offer description" />

                        <icons:MaterialIcon
                            Grid.Row="10" Grid.Column="0"
                            Kind="Pencil" Width="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox
                            Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                            Margin="4" x:Name="CustomerDescription"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="60"
                            Watermark="Customer description" />

                        <StackPanel
                            Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" Margin="4">
                            <TextBlock Text="Accepted date: " VerticalAlignment="Center" />
                            <TextBlock x:Name="AcceptedDateText" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button
                            Grid.Row="11" Grid.Column="3"
                            Margin="4" x:Name="SaveOfferFileButton"
                            HorizontalAlignment="Right"
                            Classes="Raised">
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,5,0" />
                                <TextBlock Text="Save" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</rxui:ReactiveUserControl>
