<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialThemes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="SecureDocuments.Avalonia.App">
    <Application.Styles>
        <materialThemes:MaterialTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="LightBlue" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DialogHost.Avalonia/DialogHost.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
